rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /hunts/{huntId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        (resource.data.isActive == true && request.auth.uid in resource.data.allowedUsers)
      );
      allow write: if isAdmin();

      match /clues/{clueId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    match /playerProgress/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Any logged-in user can create invites (admin gate is in the UI);
    // publicly readable so recipients don't need an account to open the link;
    // anyone can mark a pending invite as used (the Join page activation flow)
    match /invites/{token} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if resource.data.status == 'pending';
      allow delete: if isAdmin();
    }
  }
}
